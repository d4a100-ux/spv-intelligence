{
  "name": "spv-intelligence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node --env-file=.env.local scripts/validate-unit.ts",
    "key:generate": "node scripts/gen-key.ts",
    "unit:register": "node --env-file=.env.local scripts/register-unit.ts",
    "users": "node --env-file=.env.local scripts/users.ts",
    "status": "node --env-file=.env.local scripts/status.ts",
    "worker": "node --env-file=.env.local src/worker/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "sample": "node --env-file=.env.local scripts/sample-leads.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
