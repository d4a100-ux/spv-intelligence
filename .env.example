# Copie para .env.local (ignorado pelo git) e preencha NA SUA MÁQUINA.
# Nunca cole tokens ou senhas em chats, e-mails, prints ou código.

# --- Subconta sendo validada/cadastrada (uma por vez) ---
# Após "npm run unit:register", APAGUE o LC_PIT: o token passa a existir só cifrado no banco.
LC_PIT=
LC_LOCATION_ID=

# --- Banco (Supabase > Connect > Direct > Transaction pooler, porta 6543) ---
# NÃO use o Session pooler (5432): limite de 15 conexões e sessões-fantasma após quedas de rede.
DATABASE_URL=

# --- Chave de cifragem dos tokens (gere com: npm run key:generate). Guarde num cofre de senhas. ---
CREDENTIALS_KEY=

# --- Opcionais (padrões seguros) ---
# LC_BURST_MAX=70            # requisições por janela por subconta (limite documentado: 100/10s)
# LC_BURST_WINDOW_MS=10000
# LC_DAILY_RESERVE=20000     # abaixo disso, só jobs essenciais
